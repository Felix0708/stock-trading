DISCORD_OWNER_ID=
# 선택 사항: 드러켄밀러 봇이 한 서버에만 있다면 비워둬도 됩니다.
DISCORD_GUILD_ID=
DISCORD_TOKEN_DRUCKENMILLER=
DISCORD_TOKEN_ONEIL=
DISCORD_TOKEN_MINERVINI=
DISCORD_TOKEN_LIVERMORE=
DISCORD_TOKEN_QULLAMAGGIE=

# Codex CLI 모델 설정
CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=high
CODEX_TIMEOUT_MS=300000
CODEX_WEB_SEARCH=live

# 평일 자동 투자위원회 라운드테이블
AUTO_BRIEFING_ENABLED=true
AUTO_BRIEFING_CHANNEL=시장-브리핑
AUTO_BRIEFING_TIMES=08:30,15:40,22:00
AUTO_BRIEFING_TIMEZONE=Asia/Seoul
AUTO_BRIEFING_WEEKDAYS_ONLY=true
RESEARCH_ENABLED=false
RESEARCH_DIR="/absolute/path/to/iCloud/주식"
RESEARCH_LOOKBACK_DAYS=7
RESEARCH_MAX_FILES=3
RESEARCH_MAX_PAGES=5
RESEARCH_MAX_CHARS=12000
RESEARCH_MAX_IMAGES=0

# Telegram 뉴스·시황 채널의 전날 글을 Markdown으로 저장
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL_MATCH=뉴스시황
TELEGRAM_TIMEZONE=Asia/Seoul
TELEGRAM_COLLECT_TIME=00:10
TELEGRAM_OUTPUT_DIR="/absolute/path/to/iCloud/주식/텔레그램"

# 생존 투자자의 공개 보유·언급 종목과 무니 자료를 고정 상태판으로 갱신
INVESTOR_PORTFOLIO_ENABLED=true
INVESTOR_PORTFOLIO_CHANNEL=주요인사-포트폴리오
INSTITUTION_PORTFOLIO_CHANNEL=기관-포트폴리오
INVESTOR_PORTFOLIO_REFRESH_DAYS=1
# 선택 사항: SEC가 권장하는 앱명과 연락처 형식 (예: stock-trading/0.1 you@example.com)
SEC_USER_AGENT=

# TradingView Webhook (실주문 비활성)
WEBHOOK_ENABLED=true
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8787
# ngrok 대시보드에서 발급받은 고정 개발 주소
NGROK_PUBLIC_URL=https://your-domain.ngrok-free.dev
# 비우면 .webhook-token 파일에 64자리 비밀값을 자동 생성합니다.
WEBHOOK_PATH_TOKEN=
WEBHOOK_LOG_FILE=webhook-events.jsonl
WEBHOOK_SIGNAL_CHANNEL=매매신호
WEBHOOK_SYSTEM_CHANNEL=시스템상태
ORDER_APPROVAL_CHANNEL=주문승인
ORDER_EXECUTION_CHANNEL=체결로그
WATCHLIST_CHANNEL=관심종목
ALERTS_CHANNEL=알람설정
JOURNAL_CHANNEL=매매일지
WATCHLIST_SYMBOLS=
TRADINGVIEW_WATCHLIST_URL=
WATCHLIST_SYNC_TIME=08:15
WATCHLIST_SYNC_TIMEZONE=Asia/Seoul
ALERT_SYMBOLS=
TRADINGVIEW_ALERT_WATCHLIST_URL=
ALERTS_SYNC_TIME=08:20
ALERTS_SYNC_TIMEZONE=Asia/Seoul

# CHECK 워치리스트 신호 AI 사전 검토 (주문과 독립)
AI_SIGNAL_REVIEW_ENABLED=false
AI_SIGNAL_REVIEW_CHANNEL=종목-토론
AI_SIGNAL_REVIEW_BATCH_MS=5000
AI_SIGNAL_REVIEW_MAX_BATCH=10

# 자동매매 안전 모드 — LIVE 주문은 아직 지원하지 않습니다.
ACCOUNT_NEUTRAL_SIGNAL_SERVER=true
TRADING_MODE=SHADOW
MAX_OPEN_POSITIONS=5
TRADING_STATE_FILE=trading-state.json
TRADING_DECISION_LOG_FILE=trading-decisions.jsonl

# 선택 사항: 공통 대화의 키움 시세 조회와 이전 단일계좌 모드를 위한 설정입니다.
# 사용자별 키움·한투 주문 정보는 .env.account에 입력합니다.
KIWOOM_ENABLED=false
KIWOOM_ENV=mock
KIWOOM_DOMESTIC_APP_KEY=
KIWOOM_DOMESTIC_SECRET_KEY=
KIWOOM_OVERSEAS_APP_KEY=
KIWOOM_OVERSEAS_SECRET_KEY=
KIWOOM_TIMEOUT_MS=5000
PARTIAL_EXIT_1_RATIO=0.25
PARTIAL_EXIT_2_RATIO=0.50
# 실계좌 전환 전에 모의계좌에서 BUY 승인 흐름을 시험할 때만 true
BUY_APPROVAL_REQUIRED=false
# 200일선 위지만 일봉 BULL·EMA 정배열이 덜 된 초기 신호를 소액 승인 대기로 전환
EARLY_ENTRY_APPROVAL_ENABLED=true
BUY_APPROVAL_TTL_MINUTES=15

# TradingView 서버 알람→키움 국내 모의계좌 1주 주문을 단 한 번 시험합니다.
# 실제 시험 직전에만 true로 바꾸고, 완료 후 다시 false로 돌리세요.
PAPER_ORDER_TEST_ENABLED=false
PAPER_ORDER_TEST_SYMBOL=005930
PAPER_ORDER_TEST_LOCK_FILE=.paper-order-test-lock.json
