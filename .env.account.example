# 사용자별 계좌 주문 실행기 설정 예시입니다. 실제 파일은 .env.account이며 Git에 포함되지 않습니다.

# ===== 실행과 안전 잠금 =====
# true일 때 계좌 실행기를 시작합니다.
ACCOUNT_EXECUTOR_ENABLED=true
# Discord 상태 메시지에 표시할 사용자 이름입니다.
ACCOUNT_EXECUTOR_NAME=사용자A
# 처음 상태 파일이 만들어질 때 자동매매 기본값입니다. 이후 Discord에서 변경한 값은 상태 파일이 우선합니다.
ACCOUNT_AUTO_TRADING=false
# true일 때만 live 환경에서 실제 주문을 허용합니다. 읽기 전용 검증 중에는 반드시 false입니다.
ACCOUNT_LIVE_TRADING=false
# true이면 실계좌 인증·잔고·현금·테스트 신호만 확인하고 일반 주문 흐름을 건너뜁니다.
ACCOUNT_READ_ONLY=false
# 사용할 증권사를 각각 켜거나 끕니다.
EXECUTOR_KIWOOM_ENABLED=true
EXECUTOR_KIS_ENABLED=true

# ===== Discord 연결 =====
# 계좌 실행기가 로그인할 Discord 봇 토큰입니다. 비밀번호처럼 취급하고 외부에 공개하지 않습니다.
ACCOUNT_DISCORD_TOKEN=
# 공용 매매신호 채널 ID입니다. 여러 개면 쉼표로 구분합니다.
ACCOUNT_SOURCE_CHANNEL_IDS=
# 신뢰할 신호 발신 봇 ID입니다. 여러 개면 쉼표로 구분합니다.
ACCOUNT_SOURCE_BOT_IDS=
# 계좌 전용 채널이 있는 Discord 서버 ID입니다.
ACCOUNT_TARGET_GUILD_ID=
# 계좌 상태·자동매매 명령을 사용할 Discord 사용자 ID입니다.
EXECUTOR_OWNER_ID=
# 주문 승인 요청을 기록할 채널 이름 또는 ID입니다.
ACCOUNT_ORDER_CHANNEL=사용자A-주문승인
# 주문 접수·체결·취소·오류를 기록할 채널 이름 또는 ID입니다.
ACCOUNT_EXECUTION_CHANNEL=사용자A-체결로그
# 체결 완료 매매일지를 기록할 채널 이름 또는 ID입니다.
ACCOUNT_JOURNAL_CHANNEL=사용자A-매매일지
# 현재 보유 종목 상태판을 기록할 채널 이름 또는 ID입니다.
ACCOUNT_PORTFOLIO_CHANNEL=사용자A-포트폴리오
# 실행기 시작·연결 상태·수동 조회 결과를 기록할 채널 이름 또는 ID입니다.
ACCOUNT_SYSTEM_CHANNEL=사용자A-시스템상태

# ===== 키움 계좌 =====
# mock 또는 live. 선택한 환경의 키 묶음만 사용합니다.
KIWOOM_ENV=mock
# 키움 국내 모의계좌 App Key와 App Secret입니다.
KIWOOM_MOCK_DOMESTIC_APP_KEY=
KIWOOM_MOCK_DOMESTIC_SECRET_KEY=
# 키움 해외 모의계좌 App Key와 App Secret입니다.
KIWOOM_MOCK_OVERSEAS_APP_KEY=
KIWOOM_MOCK_OVERSEAS_SECRET_KEY=
# 키움 실계좌 App Key와 App Secret입니다. 국내·해외가 같은 등록 계좌면 한 쌍만 사용합니다.
KIWOOM_LIVE_APP_KEY=
KIWOOM_LIVE_SECRET_KEY=
# 키움 API 한 요청의 제한 시간(ms)입니다.
KIWOOM_TIMEOUT_MS=15000
# 키움 주문·체결·복구 상태를 저장할 로컬 파일입니다.
KIWOOM_ORDER_STATE_FILE=user-a-kiwoom-orders.json

# ===== 한국투자증권 계좌 =====
# mock 또는 live. 선택한 환경의 키·계좌번호 묶음만 사용합니다.
KIS_ENV=mock
# 한투 모의계좌 App Key, App Secret, 계좌번호입니다. 계좌번호는 12345678-01 형식입니다.
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_MOCK_ACCOUNT_NO=12345678-01
# 한투 실계좌 App Key, App Secret, 계좌번호입니다.
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=12345678-01
# 계좌번호 뒤 상품코드가 생략됐을 때 사용할 기본값입니다. 일반 종합주식계좌는 보통 01입니다.
KIS_ACCOUNT_PRODUCT_CODE=01
# 한투 API 한 요청의 제한 시간(ms)입니다.
KIS_TIMEOUT_MS=15000
# 한투 주문·체결·복구 상태를 저장할 로컬 파일입니다.
KIS_ORDER_STATE_FILE=user-a-kis-orders.json

# ===== 위험 한도와 상태 파일 =====
# 동시에 보유할 수 있는 최대 종목 수입니다.
MAX_OPEN_POSITIONS=5
# 실계좌 순자산 중 자동운용에 사용할 비율입니다. 0.10은 10%입니다.
ACCOUNT_AUTO_CAP_RATIO=0.10
# 실계좌 자동운용금 중 동시에 감수할 최대 손절 위험 비율입니다. 0.015는 1.5%입니다.
ACCOUNT_MAX_OPEN_RISK_RATIO=0.015
# TP1에서 현재 매도 가능 수량의 25%를 청산합니다.
PARTIAL_EXIT_1_RATIO=0.25
# TP2에서 TP1 이후 남은 매도 가능 수량의 50%를 청산합니다.
PARTIAL_EXIT_2_RATIO=0.50
# BUY 승인 요청이 만료되는 시간(분)입니다.
BUY_APPROVAL_TTL_MINUTES=30
# 이 시간보다 오래된 Discord 매매신호는 처리하지 않습니다.
ACCOUNT_SIGNAL_MAX_AGE_MINUTES=30
# 주문이 없어도 포트폴리오를 다시 조회하는 주기(분)입니다. 1440은 하루입니다.
ACCOUNT_PORTFOLIO_SYNC_MINUTES=1440
# 수신한 신호 ID·승인·예약·부분청산 상태를 저장할 로컬 파일입니다.
ACCOUNT_SIGNAL_RECEIPT_FILE=user-a-signal-receipts.json
