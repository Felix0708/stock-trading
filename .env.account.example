# 사용자별 계좌 주문 실행기 설정 예시입니다.
# 다른 컴퓨터에서는 이 파일만 .env.account로 복사하고 공통 신호 서버와 ngrok은 실행하지 않습니다.
ACCOUNT_EXECUTOR_ENABLED=true
ACCOUNT_EXECUTOR_NAME=사용자A
ACCOUNT_AUTO_TRADING=false
ACCOUNT_LIVE_TRADING=false
ACCOUNT_READ_ONLY=false
EXECUTOR_KIWOOM_ENABLED=true
EXECUTOR_KIS_ENABLED=true

# 공용 Discord 매매신호를 읽을 계정과 원본 위치
ACCOUNT_DISCORD_TOKEN=
ACCOUNT_SOURCE_CHANNEL_IDS=
ACCOUNT_SOURCE_BOT_IDS=
ACCOUNT_TARGET_GUILD_ID=
EXECUTOR_OWNER_ID=

# 이 사용자만 보는 결과 채널
ACCOUNT_ORDER_CHANNEL=사용자A-주문승인
ACCOUNT_EXECUTION_CHANNEL=사용자A-체결로그
ACCOUNT_JOURNAL_CHANNEL=사용자A-매매일지
ACCOUNT_PORTFOLIO_CHANNEL=사용자A-포트폴리오
ACCOUNT_PORTFOLIO_SYNC_MINUTES=1440
ACCOUNT_SYSTEM_CHANNEL=사용자A-시스템상태

# 키움 계좌. mock/live를 바꾸면 해당 키 묶음만 선택됩니다.
# live 조회 시험은 ACCOUNT_READ_ONLY=true, 실주문은 ACCOUNT_LIVE_TRADING=true가 필요합니다.
KIWOOM_ENV=mock
KIWOOM_MOCK_DOMESTIC_APP_KEY=
KIWOOM_MOCK_DOMESTIC_SECRET_KEY=
KIWOOM_MOCK_OVERSEAS_APP_KEY=
KIWOOM_MOCK_OVERSEAS_SECRET_KEY=
KIWOOM_LIVE_APP_KEY=
KIWOOM_LIVE_SECRET_KEY=
KIWOOM_TIMEOUT_MS=15000
KIWOOM_ORDER_STATE_FILE=user-a-kiwoom-orders.json

# 한국투자증권 계좌. mock/live를 바꾸면 해당 키·계좌번호 묶음만 선택됩니다.
# live 조회 시험은 ACCOUNT_READ_ONLY=true, 실주문은 ACCOUNT_LIVE_TRADING=true가 필요합니다.
KIS_ENV=mock
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_MOCK_ACCOUNT_NO=12345678-01
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=12345678-01
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_TIMEOUT_MS=15000
KIS_ORDER_STATE_FILE=user-a-kis-orders.json

# 사용자별 수신·위험 상태
ACCOUNT_SIGNAL_RECEIPT_FILE=user-a-signal-receipts.json
KIS_SIGNAL_MAX_AGE_MINUTES=30
MAX_OPEN_POSITIONS=5
# 아래 두 한도는 실계좌에만 적용됩니다. 모의계좌 수량 계산은 기존 방식 그대로입니다.
ACCOUNT_AUTO_CAP_RATIO=0.10
ACCOUNT_MAX_OPEN_RISK_RATIO=0.015
PARTIAL_EXIT_1_RATIO=0.25
PARTIAL_EXIT_2_RATIO=0.50
BUY_APPROVAL_TTL_MINUTES=30
